# NuGet packages downloaded by fetch-deps.ps1 (~450 MB).
packages/

# C++/WinRT projections generated by cppwinrt.exe from those packages
# (~145 MB of headers). Regenerate with fetch-deps.ps1.
projection/
projection-winui3/

# WinUI resource blob copied out of the NuGet package at build time.
resources.pri

# Build output.
*.exe
*.dll
*.lib
*.exp
*.obj
*.res
*.pdb
*.ilk

# Screenshots captured during verification runs.
shot*.png

# Runtime logs from verification runs.
*_log.txt
